{
  "name": "cinema-desktop",
  "productName": "Cinema",
  "version": "1.1.0",
  "description": "Cinema - assista e compartilhe a tela com os amigos",
  "author": {
    "name": "José Guilherme Peron",
    "email": "NeroWRLD@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icones": "node scripts/icones.mjs",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "app.cinema.juntos",
    "productName": "Cinema",
    "artifactName": "Cinema-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "seletor.html",
      "seletor-preload.js",
      "build/icon.png",
      "offline.html"
    ],
    "afterPack": "scripts/depois-empacotar.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Cinema",
      "artifactName": "Cinema-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Cinema-Portatil-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "cinema",
      "synopsis": "Assista e compartilhe a tela com os amigos",
      "desktop": {
        "entry": {
          "Name": "Cinema",
          "Comment": "Assista e compartilhe a tela com os amigos",
          "StartupWMClass": "Cinema"
        }
      }
    },
    "appImage": {
      "artifactName": "Cinema-${version}.AppImage"
    },
    "deb": {
      "artifactName": "cinema_${version}_amd64.deb"
    }
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.0",
    "sharp": "^0.35.5"
  },
  "homepage": "https://cinema-juntos.vercel.app"
}
